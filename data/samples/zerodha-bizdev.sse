data: {"subject": {"name": "Zerodha", "kind": "company", "goal": "bizdev", "about": "", "meeting": "2026-11-14", "meeting_time": "10:30", "identified_as": "Zerodha, the Indian brokerage firm"}, "choices": [], "warnings": [], "window": {"start": "2026-10-15", "end": "2026-11-10"}, "counts": {"found": 32, "kept": 19, "shown_to_model": 19, "verified": 5, "credits": 4}, "model": {"served_by": "groq/openai/gpt-oss-120b", "fallback": false, "prompt_tokens": 4060, "completion_tokens": 1651, "seconds": 4.1, "entity_check_by": "groq/openai/gpt-oss-20b", "entity_check_tokens": 1962}, "seconds": 10.7, "stories": [{"headline": "Angel One overtakes Zerodha in active client count", "summary": "Angel One surpassed Zerodha to become India's second\u2011largest broker by active NSE clients in October, adding 2.43\u202flakh clients while Zerodha's base fell for a second month, signaling competitive pressure.", "category": "deal", "date": "2026-11-06", "outlets": ["economictimes.com", "moneycontrol.com", "multibagg.ai"], "quote": "Angel One has overtaken Zerodha to become India's second-largest stockbroker by active clients, adding 2.43 lakh clients in October as Zerodha's base declined for the second consecutive month, according to National Stock Exchange (NSE) data.", "quote_url": "https://m.economictimes.com/tech/startups/angel-one-overtakes-zerodha-to-become-indias-2nd-largest-stockbroker/articleshow/135602404.cms", "older_event": null, "quote_site": "economictimes.com", "sources": [{"title": "Tech3 | Angel One pips Zerodha in active investors; Foreign investors cash out, mutual funds scoop up startup stocks; and more - Moneycontrol.com", "url": "https://www.moneycontrol.com/news/technology-startup/newsletters/MCTech3/tech3-angel-one-pips-zerodha-in-active-investors-foreign-investors-cash-out-mutual-funds-scoop-up-startup-stocks-and-more", "site": "moneycontrol.com", "date": "2026-11-06"}, {"title": "Angel One overtakes Zerodha to become India's second-largest stockbroker - The Economic Times", "url": "https://m.economictimes.com/tech/startups/angel-one-overtakes-zerodha-to-become-indias-2nd-largest-stockbroker/articleshow/135602404.cms", "site": "economictimes.com", "date": "2026-11-06"}, {"title": "Angel One Ltd. overtakes Zerodha with 69.98 lakh NSE clients | Market News & Analysis", "url": "https://www.multibagg.ai/market-pulse/articles/angel-one-overtakes-zerodha-clients-cmw53qjyt00222wobaygrh9pf", "site": "multibagg.ai", "date": "2026-11-06"}]}, {"headline": "Zerodha launches US stock investing beta on Kite", "summary": "Zerodha introduced a beta US\u2011stock investing facility on its Kite platform, giving Indian retail investors access to about 2,000 US stocks and 1,000 ETFs via GIFT City, expanding its product suite internationally.", "category": "product", "date": "2026-10-19", "outlets": ["cnbctv18.com", "livemint.com", "ndtvprofit.com"], "quote": "Zerodha launched its US stock investing facility in beta mode on its Kite platform, allowing retail investors to invest directly in US\u2011listed stocks such as Meta, Amazon, Google, and Microsoft, as well as exchange\u2011traded funds (ETFs) through their existing accounts.", "quote_url": "https://www.livemint.com/market/stock-market-news/zerodha-launches-us-stock-investing-how-to-invest-in-tesla-amazon-spacex-meta-micron-nvidia-and-amd-explained-11792594591349.html", "older_event": null, "quote_site": "livemint.com", "sources": [{"title": "Zerodha launches US stock investing: How to invest in Tesla, Amazon, SpaceX, Meta, Micron, Nvidia and AMD \u2014 explained | Stock Market News", "url": "https://www.livemint.com/market/stock-market-news/zerodha-launches-us-stock-investing-how-to-invest-in-tesla-amazon-spacex-meta-micron-nvidia-and-amd-explained-11792594591349.html", "site": "livemint.com", "date": "2026-10-21"}, {"title": "Zerodha enables US stock investing in beta for select users: 5 things to know - CNBC TV18", "url": "https://www.cnbctv18.com/market/zerodha-us-stock-investing-in-beta-for-select-users-5-things-to-know-20014858.htm", "site": "cnbctv18.com", "date": "2026-10-19"}, {"title": "Investing In US Stocks Through Zerodha? Charges, Tax Rules And LRS Limits Explained", "url": "https://www.ndtvprofit.com/personal-finance/investing-in-us-stocks-through-zerodha-charges-tax-rules-and-lrs-limits-explained-12205187", "site": "ndtvprofit.com", "date": "2026-10-19"}]}, {"headline": "Zerodha Fund House releases BSE Top 10 Banks ETF", "summary": "The firm rolled out a new open\u2011ended ETF tracking the BSE Top 10 Banks Index, offering investors a single\u2011ticket exposure to India's largest banks, with a minimum investment of \u20b91,000.", "category": "product", "date": "2026-10-21", "outlets": ["economictimes.com"], "quote": "Zerodha Fund House has launched the Zerodha BSE Top 10 Banks ETF, an open\u2011ended exchange\u2011traded fund (ETF) that seeks to track the performance of the BSE Top 10 Banks Index, offering investors exposure to India's 10 largest banks through a single investment.", "quote_url": "https://m.economictimes.com/markets/stocks/news/want-exposure-to-indias-biggest-banks-zerodha-launches-new-etf/articleshow/135090790.cms", "older_event": null, "quote_site": "economictimes.com", "sources": [{"title": "Want exposure to India's biggest banks? Zerodha launches new ETF - The Economic Times", "url": "https://m.economictimes.com/markets/stocks/news/want-exposure-to-indias-biggest-banks-zerodha-launches-new-etf/articleshow/135090790.cms", "site": "economictimes.com", "date": "2026-10-21"}]}, {"headline": "Life Cycle Funds reach \u20b938\u202fcr AUM", "summary": "Zerodha Fund House\u2019s Life Cycle Funds accumulated \u20b938\u202fcrore in net assets under management by August, reflecting growing interest in goal\u2011based investing among retail clients.", "category": "product", "date": "2026-10-20", "outlets": ["cnbctv18.com", "fintechbiznews.com"], "quote": "Zerodha Fund House\u2019s Life Cycle Funds had garnered \u20b938 crore in net assets under management (AUM) as of August, according to data cited from the Association of Mutual Funds in India (AMFI), said Vishal Jain, CEO of Zerodha Fund House.", "quote_url": "https://www.cnbctv18.com/personal-finance/life-cycle-funds-zerodha-fund-house-ceo-5-things-investors-should-know-20020479.htm", "older_event": null, "quote_site": "cnbctv18.com", "sources": [{"title": "Life Cycle Funds: Zerodha Fund House CEO shares 5 things investors should know - CNBC TV18", "url": "https://www.cnbctv18.com/personal-finance/life-cycle-funds-zerodha-fund-house-ceo-5-things-investors-should-know-20020479.htm", "site": "cnbctv18.com", "date": "2026-10-27"}, {"title": "Life Cycle Funds Launched By Zerodha Fund House", "url": "https://www.fintechbiznews.com/finserv-mf-amcs/life-cycle-funds-launched-by-zerodha-fund-house", "site": "fintechbiznews.com", "date": "2026-10-20"}]}, {"headline": "Nithin Kamath sparks debate on Indian investing trends", "summary": "CEO Nithin Kamath posted charts comparing equity participation growth to overall savings, prompting discussion on whether rising asset\u2011rich Indians are simply getting richer or if broader investment participation is expanding.", "category": "people", "date": "2026-10-16", "outlets": ["livemint.com"], "quote": "Zerodha founder and CEO Nithin Kamath has raised this question through a series of charts tracking the growth of India's financial savings, equity holdings and market activity between 2015 and 2026.", "quote_url": "https://www.livemint.com/money/personal-finance/are-indians-investing-more-or-are-asset-rich-indians-getting-richer-zerodhas-nithin-kamath-sparks-debate-online-11792136945684.html", "older_event": null, "quote_site": "livemint.com", "sources": [{"title": "Are Indians investing more, or are asset-rich Indians getting richer? Zerodha's Nithin Kamath sparks debate online | Mint", "url": "https://www.livemint.com/money/personal-finance/are-indians-investing-more-or-are-asset-rich-indians-getting-richer-zerodhas-nithin-kamath-sparks-debate-online-11792136945684.html", "site": "livemint.com", "date": "2026-10-16"}]}], "talking_points": [{"text": "Assess impact of Angel One's client surge on Zerodha's market share and retention strategies.", "stories": [1]}, {"text": "Explore partnership or differentiation opportunities around the new US\u2011stock investing beta.", "stories": [2]}, {"text": "Discuss cross\u2011selling potential between the BSE Top 10 Banks ETF and existing client base.", "stories": [3]}, {"text": "Evaluate scaling the Life Cycle Funds model to attract goal\u2011oriented investors.", "stories": [4]}, {"text": "Leverage Nithin Kamath's market insights to shape outreach to under\u2011penetrated investor segments.", "stories": [5]}], "open_questions": [{"text": "What initiatives are planned to regain active client growth after the recent dip?", "stories": [1]}, {"text": "How can Zerodha enhance the US\u2011stock offering to increase adoption beyond beta users?", "stories": [2]}, {"text": "Are there plans to launch additional thematic ETFs following the banks ETF success?", "stories": [3]}, {"text": "What marketing strategies will drive higher AUM for Life Cycle Funds in the next quarter?", "stories": [4]}, {"text": "How does Zerodha intend to broaden equity participation beyond the current sub\u20115\u202f% penetration?", "stories": [5]}], "ledger": {"articles": [{"title": "News by CNBC TV18 on TradingView, 2026-11-04 \u2014 cnbctv:1f062dde7094b:0", "url": "https://www.tradingview.com/news/cnbctv:1f062dde7094b:0", "site": "tradingview.com", "reason": "'Zerodha' only mentioned in passing, not in the headline"}, {"title": "Weekly Tidbits #12 - The Daily Brief by Zerodha", "url": "https://thedailybrief.zerodha.com/p/weekly-tidbits-12", "site": "thedailybrief.zerodha.com", "reason": "duplicate of a page already kept"}, {"title": "Angel One begins US stock investing rollout, to launch corporate bonds in a fortnight, says CEO Ambarish Kenghe", "url"