data: {"subject": {"name": "Zerodha", "kind": "company", "goal": "partnership", "about": "", "meeting": "2026-11-14", "meeting_time": "10:30", "identified_as": "Zerodha"}, "choices": [], "window": {"start": "2026-10-11", "end": "2026-11-10"}, "counts": {"found": 32, "kept": 15, "shown_to_model": 15, "verified": 4, "credits": 0}, "model": {"served_by": "groq/openai/gpt-oss-120b", "fallback": false, "prompt_tokens": 3279, "completion_tokens": 1673, "seconds": 3.9, "entity_check_by": "groq/openai/gpt-oss-20b", "entity_check_tokens": 1991}, "seconds": 6.7, "stories": [{"headline": "Zerodha rolls out US stock investing beta", "summary": "Zerodha opened a beta for Indian investors to trade US equities and ETFs through its Kite platform, expanding its product suite beyond domestic markets.", "category": "product", "date": "2026-10-19", "outlets": ["cnbctv18.com"], "quote": "Zerodha launched US stock investing in beta mode for select users via GIFT City, offering access to 2,000 stocks and 1,000 ETFs with a 0.1% brokerage fee capped at $10.", "quote_url": "https://www.cnbctv18.com/market/zerodha-us-stock-investing-in-beta-for-select-users-5-things-to-know-20014858.htm", "older_event": null, "quote_site": "cnbctv18.com", "sources": [{"title": "Zerodha enables US stock investing in beta for select users: 5 things to know - CNBC TV18", "url": "https://www.cnbctv18.com/market/zerodha-us-stock-investing-in-beta-for-select-users-5-things-to-know-20014858.htm", "site": "cnbctv18.com", "date": "2026-10-19"}]}, {"headline": "Zerodha launches BSE Top 10 Banks ETF", "summary": "The new open\u2011ended ETF gives investors a single\u2011ticket exposure to India\u2019s ten largest banks, diversifying Zerodha\u2019s fund offerings.", "category": "product", "date": "2026-10-21", "outlets": ["economictimes.com"], "quote": "Zerodha Fund House has launched the Zerodha BSE Top 10 Banks ETF, an open-ended exchange-traded fund (ETF) that seeks to track the performance of the BSE Top 10 Banks Index.", "quote_url": "https://m.economictimes.com/markets/stocks/news/want-exposure-to-indias-biggest-banks-zerodha-launches-new-etf/articleshow/135090790.cms", "older_event": null, "quote_site": "economictimes.com", "sources": [{"title": "Want exposure to India's biggest banks? Zerodha launches new ETF - The Economic Times", "url": "https://m.economictimes.com/markets/stocks/news/want-exposure-to-indias-biggest-banks-zerodha-launches-new-etf/articleshow/135090790.cms", "site": "economictimes.com", "date": "2026-10-21"}]}, {"headline": "Life Cycle Funds reach \u20b938\u202fcr AUM", "summary": "Zerodha\u2019s Life Cycle Funds, aimed at goal\u2011based investing, have accumulated \u20b938\u202fcrore in assets, reflecting growing retail interest in target\u2011date products.", "category": "product", "date": "2026-10-27", "outlets": ["cnbctv18.com"], "quote": "Zerodha Fund House\u2019s Life Cycle Funds had garnered \u20b938 crore in net assets under management (AUM) as of August.", "quote_url": "https://www.cnbctv18.com/personal-finance/life-cycle-funds-zerodha-fund-house-ceo-5-things-investors-should-know-20020479.htm", "older_event": null, "quote_site": "cnbctv18.com", "sources": [{"title": "Life Cycle Funds: Zerodha Fund House CEO shares 5 things investors should know - CNBC TV18", "url": "https://www.cnbctv18.com/personal-finance/life-cycle-funds-zerodha-fund-house-ceo-5-things-investors-should-know-20020479.htm", "site": "cnbctv18.com", "date": "2026-10-27"}]}, {"headline": "Zerodha faces competition from Groww on active clients", "summary": "In an interview, Nikhil Kamath acknowledges Groww\u2019s venture\u2011backed growth has overtaken Zerodha in active client numbers, raising strategic questions about scaling without VC funding.", "category": "people", "date": "2026-10-22", "outlets": ["ndtv.com"], "quote": "Kanwal asked Kamath how competitive he was at work and whether it irked him that Groww, which had venture capital backing, had overtaken Zerodha in active clients.", "quote_url": "https://www.ndtv.com/world-news/groww-did-well-what-zerodha-co-founder-nikhil-kamath-said-on-rival-12219480", "older_event": null, "quote_site": "ndtv.com", "sources": [{"title": "'Groww Did Well': What Zerodha Co-Founder Nikhil Kamath Said On Rival", "url": "https://www.ndtv.com/world-news/groww-did-well-what-zerodha-co-founder-nikhil-kamath-said-on-rival-12219480", "site": "ndtv.com", "date": "2026-10-22"}]}], "talking_points": [{"text": "Explore the partnership potential around cross\u2011border product offerings, building on the US stock beta launch.", "stories": [1]}, {"text": "Assess the fit of Zerodha\u2019s ETF and Life Cycle Fund platforms for co\u2011branded investment solutions.", "stories": [2, 3]}, {"text": "Consider collaborative approaches to scaling client acquisition without relying on venture capital.", "stories": [4]}], "open_questions": [{"text": "Can the US stock beta be expanded to a full launch, and what infrastructure or regulatory support would be needed from a partner?", "stories": [1]}, {"text": "How does Zerodha envision the next generation of ETFs or target\u2011date funds, and are there co\u2011creation opportunities?", "stories": [2, 3]}, {"text": "Given the competitive pressure from Groww, what non\u2011VC growth levers is Zerodha prioritising?", "stories": [4]}], "ledger": {"articles": [{"title": "News by CNBC TV18 on TradingView, 2026-11-04 \u2014 cnbctv:1f062dde7094b:0", "url": "https://www.tradingview.com/news/cnbctv:1f062dde7094b:0", "site": "tradingview.com", "reason": "'Zerodha' only mentioned in passing, not in the headline"}, {"title": "Weekly Tidbits #12 - The Daily Brief by Zerodha", "url": "https://thedailybrief.zerodha.com/p/weekly-tidbits-12", "site": "thedailybrief.zerodha.com", "reason": "duplicate of a page already kept"}, {"title": "Zerodha", "url": "https://tavily.com/knowledge/company/MEsTt2oWa6DL", "site": "tavily.com", "reason": "not a news article (search engine's own profile page)"}, {"ti