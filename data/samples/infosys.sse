data: {"subject": {"name": "Infosys", "kind": "company", "goal": "investor", "meeting": "2026-11-14"}, "window": {"start": "2026-10-11", "end": "2026-11-10"}, "counts": {"found": 32, "kept": 25, "shown_to_model": 20, "verified": 5, "credits": 0}, "model": {"served_by": "groq/openai/gpt-oss-120b", "fallback": false, "prompt_tokens": 4032, "completion_tokens": 2952, "seconds": 8.8}, "seconds": 8.8, "stories": [{"headline": "Infosys opens 1.1M sq ft development block in Hyderabad", "summary": "Infosys inaugurated a 1.1 million square\u2011foot software development block at its Pocharam campus, expanding capacity for AI, cloud, cybersecurity and digital services.", "category": "other", "date": "2026-10-31", "outlets": ["peoplematters.in"], "quote": "Infosys on Friday announced the expansion of its Development Centre (DC) at Pocharam here, with the inauguration of a 1.1 million sq ft Software Development Block.", "quote_url": "https://www.peoplematters.in/news/business/infosys-opens-11-million-sq-ft-new-software-development-block-at-pocharam-campus-in-hyderabad-53084", "quote_site": "peoplematters.in", "sources": [{"title": "Infosys opens 1.1 million sq ft new Software Development Block at Pocharam campus in Hyderabad", "url": "https://www.peoplematters.in/news/business/infosys-opens-11-million-sq-ft-new-software-development-block-at-pocharam-campus-in-hyderabad-53084", "site": "peoplematters.in", "date": "2026-10-31"}]}, {"headline": "Infosys secures $5.2B in large deals, including $2B mega contract", "summary": "During Q2 Infosys booked $5.2\u202fbillion of large\u2011deal contract value, with 62% net new business and a mega deal exceeding $2\u202fbillion, underscoring strong demand for transformation programs.", "category": "deal", "date": "2026-10-23", "outlets": ["crnasia.com", "investing.com", "ndtvprofit.com", "proactiveinvestors.com"], "quote": "The Bengaluru-based company secured large deals with a total contract value of $5.2 billion during the quarter, of which 62% was net new business.", "quote_url": "https://www.investing.com/news/stock-market-news/infosys-shares-dip-as-lower-growth-outlook-offsets-strong-deal-wins-4971405", "quote_site": "investing.com", "sources": [{"title": "Infosys shares dip as lower growth outlook offsets strong deal wins", "url": "https://www.investing.com/news/stock-market-news/infosys-shares-dip-as-lower-growth-outlook-offsets-strong-deal-wins-4971405", "site": "investing.com", "date": "2026-10-26"}, {"title": "Infosys Q2 Earnings: \u2018We remain the preferred AI strategy and deployment partner for our top clients,\u2019 CEO says", "url": "https://www.crnasia.com/india/news/2026/infosys-q2-earnings-we-remain-the-preferred-ai-strategy-and-deployment-partner-for-our-top-clients-ceo-says", "site": "crnasia.com", "date": "2026-10-23"}, {"title": "Infosys shares fall as revenue misses estimates and guidance disappoints | NASDAQ:INFY", "url": "https://www.proactiveinvestors.com/companies/news/1100624/infosys-shares-fall-as-revenue-misses-estimates-and-guidance-disappoints-1100624.html", "site": "proactiveinvestors.com", "date": "2026-10-23"}, {"title": "TCS Vs Infosys Vs HCLTech Vs Wipro: Who Leads In AI, Deal Wins And Hiring After Q2?", "url": "https://www.ndtvprofit.com/markets/tcs-vs-infosys-vs-hcltech-vs-wipro-who-leads-in-ai-deal-wins-and-hiring-after-q2-12227537", "site": "ndtvprofit.com", "date": "2026-10-23"}]}, {"headline": "Infosys declares Rs 26 per share interim dividend", "summary": "The company announced an interim dividend of Rs\u202f26 per equity share, with a record date of 3\u202fNov and payment scheduled for 11\u202fNov, reflecting a 4.16% yield.", "category": "results", "date": "2026-10-23", "outlets": ["economictimes.com", "upstox.com"], "quote": "IT major Infosys has announced an interim dividend of Rs 26 per equity share for its shareholders, with the record date being fixed on November 3.", "quote_url": "https://m.economictimes.com/markets/stocks/earnings/infosys-dividend-alert-it-major-announces-rs-26-per-share-dividend-check-record-date/articleshow/135143574.cms", "quote_site": "economictimes.com", "sources": [{"title": "Infosys dividend alert! IT major announces Rs 26 per share dividend. Check record date - The Economic Times", "url": "https://m.economictimes.com/markets/stocks/earnings/infosys-dividend-alert-it-major-announces-rs-26-per-share-dividend-check-record-date/articleshow/135143574.cms", "site": "economictimes.com", "date": "2026-10-23"}, {"title": "Infosys announces interim dividend of \u20b926 per share; check record, payment dates", "url": "https://upstox.com/news/market-news/stocks/infosys-announces-interim-dividend-of-26-per-share-check-record-date/article-202320", "site": "upstox.com", "date": "2026-10-23"}]}, {"headline": "CEO says US immigration limits won\u2019t raise costs or attrition", "summary": "Infosys CEO Salil Parekh reassured investors that tighter US immigration rules will not increase operating costs or lead to higher employee attrition.", "category": "people", "date": "2026-10-27", "outlets": ["channeldive.com"], "quote": "Infosys CEO says US immigration constraints won't raise costs or attrition.", "quote_url": "https://www.channeldive.com/news/infosys-ceo-says-us-immigration-constraints-wont-raise-costs-or-attrition/873098", "quote_site": "channeldive.com", "sources": [{"title": "Infosys CEO says US immigration constraints won\u2019t raise costs or attrition", "url": "https://www.channeldive.com/news/infosys-ceo-says-us-immigration-constraints-wont-raise-costs-or-attrition/873098", "site": "channeldive.com", "date": "2026-10-27"}]}, {"headline": "Truist partnership expands AI\u2011first Global Capability Center in Hyderabad", "summary": "Infosys and Truist are scaling an AI\u2011first Global Capability Center in Hyderabad, adding 1,000 staff initially and planning further expansion under a BOT model.", "category": "deal", "date": "2026-10-19", "outlets": ["economictimes.com", "finance.yahoo.com", "prnewswire.com"], "quote": "The GCC will be adding 1,000 employees later this month, Infosys informed in a statement, and is expected to further expand with more people.", "quote_url": "https://m.economictimes.com/tech/information-tech/infosys-expands-partnership-with-truist-builds-ai-first-gcc-in-hyderabad/articleshow/135051503.cms", "quote_site": "economictimes.com", "sources": [{"title": "Infosys and Truist Strengthen Strategic Collaboration to Build a Global Capability Center in India", "url": "https://www.prnewswire.com/news-releases/infosys-and-truist-strengthen-strategic-collaboration-to-build-a-global-capability-center-in-india-302912501.html", "site": "prnewswire.com", "date": "2026-10-19"}, {"title": "Infosys expands partnership with Truist, builds AI-first GCC in Hyderabad - The Economic Times", "url": "https://m.economictimes.com/tech/information-tech/infosys-expands-partnership-with-truist-builds-ai-first-gcc-in-hyderabad/articleshow/135051503.cms", "site": "economictimes.com", "date": "2026-10-19"}, {"title": "Infosys, Truist Expand Partnership for AI Center in India", "url": "https://finance.yahoo.com/technology/ai/articles/infosys-truist-expand-partnership-ai-110629364.html", "site": "finance.yahoo.com", "date": "2026-10-19"}]}], "talking_points": [{"text": "Strong momentum from $5.2B of large deals and rapid AI services growth.", "stories": [2]}, {"text": "Capacity expansion at Pocharam enhances AI, cloud and cybersecurity delivery.", "stories": [1]}, {"text": "Dividend payout demonstrates commitment to shareholder returns.", "stories": [3]}, {"text": "US immigration constraints are not expected to affect cost structure.", "stories": [4]}], "open_questions": [{"text": "What is the outlook for sustaining the deal pipeline after the recent $5.2B wins?", "stories": [2]}, {"text": "How will the new Hyderabad development block translate into AI service capacity and revenue?", "stories": [1]}, {"text": "What revenue and talent impact does the expanded AI\u2011first GCC with Truist anticipate?", "stories": [5]}, {"text": "How does management balance dividend payouts with reinvestment in AI capabilities?", "stories": [3]}], "ledger": {"articles": [{"title": "Infosys", "url": "https://tavily.com/knowledge/company/Gbd7vUUlzCYP", "site": "tavily.com", "reason": "not a news article (search engine's own profile page)"}, {"title": "Infosys", "url": "https://tavily.com/knowledge/company/Gbd7vUUlzCYP", "site": "tavily.com", "reason": "not a news article (search engine's own profile page)"}, {"title": "Toptal AI Launches, Delivers Frontier-grade AI With Open-weight Models and Full Data Ownership", "url": "https://pressreleasehub.pa.media/article/toptal-ai-launches-delivers-frontier-grade-ai-with-open-weight-models-and-full-data-ownership-88497.html", "site": "pressreleasehub.pa.media", "reason": "'Infosys' only mentioned in passing, not in the headline"}, {"title": "Fast-fashion supply chains: From challenges to a responsive model", "url": "https://www.infosys.com/iki/perspectives/fast-fashion-supply-chains.html", "site": "infosys.com", "reason": "'Infosys' only mentioned in passing, not in the headline"}, {"title": "Infosys CEO Salil Parekh: AI demand growing, services reach 8% revenue | Business News - The Indian Express", "url": "https://indianexpress.com/article/business/infosys-tech-ceo-salil-parekh-ai-demand-growth-energy-bottleneck-bloomberg-forum-10920080", "site": "indianexpress.com", "reason": "duplicate of a page already kept"}, {"title": "Infosys", "url": "https://tavily.com/knowledge/company/Gbd7vUUlzCYP", "site": "tavily.com", "reason": "not a news article (search engine's own profile page)"}, {"title": "Infosys", "url": "https://tavily.com/knowledge/company/Gbd7vUUlzCYP", "site": "tavily.com", "reason": "not a news article (search engine's own profile page)"}], "draft": [{"item": "AI services now 8% of revenue, growing double\u2011digit quarterly", "reason": "quote not found word for word in the cited article"}]}}

