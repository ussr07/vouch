data: {"subject": {"name": "Zerodha", "kind": "company", "goal": "partnership", "about": "", "meeting": "2026-11-14", "meeting_time": "10:30", "identified_as": "Zerodha, the Indian brokerage and fintech company"}, "choices": [], "warnings": [], "window": {"start": "2026-10-11", "end": "2026-11-10"}, "counts": {"found": 32, "kept": 19, "shown_to_model": 19, "verified": 4, "credits": 0}, "model": {"served_by": "groq/openai/gpt-oss-120b", "fallback": false, "prompt_tokens": 4055, "completion_tokens": 1734, "seconds": 4.3, "entity_check_by": "groq/openai/gpt-oss-20b", "entity_check_tokens": 1989}, "seconds": 7.2, "stories": [{"headline": "Zerodha's Rainmatter co\u2011leads $3\u202fM round in Venttup", "summary": "Rainmatter and Unicorn India Ventures invested $3\u202fmillion in precision\u2011manufacturing startup Venttup, signalling Zerodha\u2019s bet on deep\u2011tech ventures as the ecosystem matures.", "category": "deal", "date": "2026-10-30", "outlets": ["indianstartupnews.com"], "quote": "We have seen the speed at which the company is growing. This prompted us to co\u2011lead this round with Rainmatter as we believe that as a pure play deep tech investor, we are the right partners for Venttup to help them scale,\" Majumdar said.", "quote_url": "https://indianstartupnews.com/funding/zerodhas-rainmatter-unicorn-india-ventures-invest-3-million-in-precision-manufacturing-startup-venttup-12765648", "older_event": null, "quote_site": "indianstartupnews.com", "sources": [{"title": "Zerodha's Rainmatter, Unicorn India Ventures invest $3 million in precision manufacturing startup Venttup", "url": "https://indianstartupnews.com/funding/zerodhas-rainmatter-unicorn-india-ventures-invest-3-million-in-precision-manufacturing-startup-venttup-12765648", "site": "indianstartupnews.com", "date": "2026-10-30"}]}, {"headline": "Zerodha launches US stock investing beta", "summary": "Zerodha opened a beta for select users to trade US\u2011listed stocks and ETFs via its Kite platform, offering fractional investing and a capped 0.1% brokerage fee, expanding its product suite beyond Indian markets.", "category": "product", "date": "2026-10-19", "outlets": ["cnbctv18.com"], "quote": "Zerodha has begun enabling US stock investing in beta mode for select users, allowing eligible Indian investors to access US\u2011listed stocks and exchange\u2011traded funds (ETFs) through its Kite platform.", "quote_url": "https://www.cnbctv18.com/market/zerodha-us-stock-investing-in-beta-for-select-users-5-things-to-know-20014858.htm", "older_event": null, "quote_site": "cnbctv18.com", "sources": [{"title": "Zerodha enables US stock investing in beta for select users: 5 things to know - CNBC TV18", "url": "https://www.cnbctv18.com/market/zerodha-us-stock-investing-in-beta-for-select-users-5-things-to-know-20014858.htm", "site": "cnbctv18.com", "date": "2026-10-19"}]}, {"headline": "Zerodha Fund House launches BSE Top\u202f10 Banks ETF", "summary": "The new open\u2011ended ETF tracks the BSE Top\u202f10 Banks Index, giving investors exposure to India\u2019s largest lenders through a single product, reinforcing Zerodha\u2019s move into diversified asset\u2011class offerings.", "category": "product", "date": "2026-10-21", "outlets": ["economictimes.com"], "quote": "Zerodha Fund House has launched the Zerodha BSE Top 10 Banks ETF, an open\u2011ended exchange\u2011traded fund (ETF) that seeks to track the performance of the BSE Top 10 Banks Index.", "quote_url": "https://m.economictimes.com/markets/stocks/news/want-exposure-to-indias-biggest-banks-zerodha-launches-new-etf/articleshow/135090790.cms", "older_event": null, "quote_site": "economictimes.com", "sources": [{"title": "Want exposure to India's biggest banks? Zerodha launches new ETF - The Economic Times", "url": "https://m.economictimes.com/markets/stocks/news/want-exposure-to-indias-biggest-banks-zerodha-launches-new-etf/articleshow/135090790.cms", "site": "economictimes.com", "date": "2026-10-21"}]}, {"headline": "Life Cycle Funds achieve \u20b938\u202fcr AUM", "summary": "Zerodha Fund House\u2019s Life Cycle Funds reached \u20b938\u202fcrore in assets under management, targeting retail investors with goal\u2011based, target\u2011date solutions as part of its broader retail\u2011focused product strategy.", "category": "product", "date": "2026-10-27", "outlets": ["cnbctv18.com"], "quote": "Zerodha Fund House\u2019s Life Cycle Funds had garnered \u20b938 crore in net assets under management (AUM) as of August, according to data cited from the Association of Mutual Funds in India (AMFI), said Vishal Jain, CEO of Zerodha Fund House.", "quote_url": "https://www.cnbctv18.com/personal-finance/life-cycle-funds-zerodha-fund-house-ceo-5-things-investors-should-know-20020479.htm", "older_event": null, "quote_site": "cnbctv18.com", "sources": [{"title": "Life Cycle Funds: Zerodha Fund House CEO shares 5 things investors should know - CNBC TV18", "url": "https://www.cnbctv18.com/personal-finance/life-cycle-funds-zerodha-fund-house-ceo-5-things-investors-should-know-20020479.htm", "site": "cnbctv18.com", "date": "2026-10-27"}]}], "talking_points": [{"text": "Explore how Rainmatter\u2019s deep\u2011tech investment aligns with our strategic fit and co\u2011investment potential.", "stories": [1]}, {"text": "Assess the US stock beta as a gateway for joint product development or cross\u2011selling.", "stories": [2]}, {"text": "Consider leveraging the new Banks ETF to broaden our combined offering to institutional clients.", "stories": [3]}, {"text": "Evaluate Life Cycle Funds as a model for goal\u2011based solutions we could co\u2011create.", "stories": [4]}], "open_questions": [{"text": "What synergies do you see between Zerodha\u2019s deep\u2011tech bets and our own technology roadmap?", "stories": [1]}, {"text": "How can we jointly expand US\u2011equity access for Indian retail investors?", "stories": [2]}, {"text": "Would a co\u2011branded ETF targeting specific sectors be of interest to 