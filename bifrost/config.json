{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "drop_excess_requests": false
  },
  "providers": {
    "groq": {
      "keys": [
        { "name": "groq-free", "value": "env.GROQ_API_KEY", "models": ["*"], "weight": 1.0 }
      ]
    },
    "gemini": {
      "keys": [
        { "name": "gemini-free", "value": "env.GEMINI_API_KEY", "models": ["*"], "weight": 1.0 }
      ]
    }
  },
  "config_store": {
    "enabled": false
  }
}
